# Normalise line endings to LF in the repository on every platform.
* text=auto eol=lf

# Lockfiles and generated files: collapse in diffs, skip in language stats.
Cargo.lock linguist-generated=true -diff
go.sum linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
yarn.lock linguist-generated=true -diff
pkgs/portal/examples/entities.yaml linguist-generated=true
.github/labeler.yml linguist-generated=true
.github/workflows/pkg-*.yml linguist-generated=true

# Binary assets
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.avif binary
