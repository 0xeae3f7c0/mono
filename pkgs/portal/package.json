{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.15.0 || ^26.13.0"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "ci": "yarn tsc && backstage-cli repo test"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.8",
    "@backstage/cli-defaults": "^0.1.8",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "^30.5.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0"
  },
  "resolutions": {
    "@yarnpkg/core": "4.9.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tar@npm:^6.1.11": "^7.5.23",
    "tar@npm:^6.2.1": "^7.5.23",
    "minimatch@npm:^9.0.4": "^11.0.9",
    "minimatch@npm:^9.0.9": "^11.0.9",
    "minimatch@npm:^10.2.2": "^11.0.9",
    "minimatch@npm:^10.2.6": "^11.0.9",
    "glob@npm:^10.0.0": "^14.0.6",
    "glob@npm:^10.2.2": "^14.0.6",
    "glob@npm:^10.3.10": "^14.0.6",
    "glob@npm:^10.4.1": "^14.0.6",
    "glob@npm:^13.0.6": "^14.0.6",
    "uuid@npm:^3.4.0": "^11.1.1",
    "uuid@npm:^8.3.2": "^11.1.1",
    "uuid@npm:^9.0.0": "^11.1.1",
    "uuid@npm:^9.0.1": "^11.1.1",
    "uuid@npm:^10.0.0": "^11.1.1"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0",
  "description": "Backstage developer portal cataloguing every service in the commit platform"
}
