{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Hourly version updates for Cargo, Go, Python (uv), OpenTofu and npm, run by .github/workflows/renovate.yml. Dependabot keeps GitHub Actions, Docker, the dev container and security updates.",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "gomod",
    "pep621",
    "terraform",
    "npm"
  ],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "labels": [
    "kind/deps",
    "source/renovate"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Replacement PRs (e.g. @tsconfig/node24 -> node26) swap the package but not the code or config that uses it, so they fail CI and need hand edits. Renovate closes open ones.",
      "matchUpdateTypes": [
        "replacement"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "addLabels": [
        "lang/rust"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Only the commit CLI (root Cargo.toml and crates/) is released by release-please, so only its dependency updates use fix(deps). Updates in pkgs/ use chore(deps) and do not cut a release.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "addLabels": [
        "lang/go"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "addLabels": [
        "lang/python"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": [
        "terraform"
      ],
      "addLabels": [
        "lang/terraform",
        "area/infra"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Yarn projects set npmMinimalAgeGate: 3d and reject newer releases (YN0016).",
      "matchManagers": [
        "npm"
      ],
      "addLabels": [
        "lang/js"
      ],
      "semanticCommitType": "chore",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "TypeScript majors break frameworks that pin it (Angular in pkgs/admin).",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Lockstep packages move together.",
      "matchPackageNames": [
        "vitest",
        "@vitest/**"
      ],
      "groupName": "vitest"
    },
    {
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**"
      ],
      "groupName": "angular"
    },
    {
      "matchPackageNames": [
        "@nestjs/**"
      ],
      "groupName": "nestjs"
    },
    {
      "matchPackageNames": [
        "@backstage/**"
      ],
      "groupName": "backstage"
    },
    {
      "matchPackageNames": [
        "@docusaurus/**"
      ],
      "groupName": "docusaurus"
    },
    {
      "matchPackageNames": [
        "storybook",
        "@storybook/**"
      ],
      "groupName": "storybook"
    },
    {
      "matchPackageNames": [
        "vue",
        "@vue/**"
      ],
      "groupName": "vue"
    },
    {
      "matchPackageNames": [
        "svelte",
        "@sveltejs/**"
      ],
      "groupName": "sveltekit"
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "matchPackageNames": [
        "@testing-library/**"
      ],
      "groupName": "testing-library"
    },
    {
      "description": "Dev-only and lockfile-only updates do not change what ships, so they use chore(deps), which release-please does not release.",
      "matchDepTypes": [
        "devDependencies",
        "dev-dependencies",
        "dev",
        "build-dependencies"
      ],
      "semanticCommitType": "chore"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "pin",
        "digest"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Backstage in pkgs/portal does not support React 19 yet.",
      "matchFileNames": [
        "pkgs/portal/**"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "allowedVersions": "<19"
    }
  ]
}
